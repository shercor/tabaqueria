# Copia este archivo como .env y completa los valores

# --- Base de datos ---
BD_NOMBRE=tabaqueria
BD_USER=root
BD_PASSWORD=secret
# Fuera de Docker: 127.0.0.1 y 4306 (el puerto que expone docker-compose)
BD_HOST=127.0.0.1
BD_PORT=4306
# true para ver en consola cada consulta SQL
BD_LOG=false

# --- Seguridad ---
# Firma de los JWT de sesión: usa un valor largo y aleatorio
JWT_SECRET=
# Opcional: si no se define se deriva de JWT_SECRET
CSRF_SECRET=

# --- App ---
PORT=3000
NOMBRE_TIENDA=Tabaquería
# Base de los enlaces de los emails. Si no se define: BACKEND_URL + PORT
APP_URL=
BACKEND_URL=http://localhost

# --- Email (por ejemplo Mailtrap). Sin EMAIL_HOST los enlaces se muestran en consola ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Tabaquería <no-reply@tabaqueria.local>
