{
  "name": "tabaqueria_web",
  "version": "1.0.0",
  "description": "Tienda web para tabaquería",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:docker": "nodemon --legacy-watch src/server.js",
    "migrate": "node src/database/migrar.js up",
    "migrate:down": "node src/database/migrar.js down",
    "seed": "node src/database/sembrar.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Sebastian Herrera",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.4.0",
    "pug": "^3.0.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2"
  }
}
