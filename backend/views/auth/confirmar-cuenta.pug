extends ../layout/index

block contenido
    div.py-5 
        h1(class="d-flex justify-content-center") Nombre
            span Proyecto
        div(class="d-flex justify-content-center" style="font-size: 30px;")= texto

        .mx-auto.my-4(style="max-width:500px;")
            p(class= error ? 'alert alert-danger' : 'alert alert-success').fw-bold.text-center= mensaje

            if !error
                a(href="/auth/login" class="d-block text-center fw-bold fs-4") Ya puedes iniciar sesión