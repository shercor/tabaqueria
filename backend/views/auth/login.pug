extends ../layouts/auth
include ../mixins/formulario

block titulo
    | Inicia Sesión

block formulario
    form(method="POST" action="/auth/login" novalidate)
        input(type="hidden" name="_csrf" value=csrfToken)
        +campo('email', 'Email de Registro', 'email')(placeholder="Tu Email" autocomplete="email")
        +campo('password', 'Contraseña', 'password')(placeholder="Tu Password" autocomplete="current-password")
        div.d-flex.justify-content-between.mt-2
            a.text-muted.text-decoration-none(href="/auth/registro") ¿No tienes cuenta? Crea una
            a.text-muted.text-decoration-none(href="/auth/olvide-password") Olvidé mi Password
        button.btn.btn-primary.mt-3(type="submit") Iniciar Sesión
