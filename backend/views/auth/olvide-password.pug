extends ../layouts/auth
include ../mixins/formulario

block titulo
    | Recupera tu Password

block formulario
    form(method="POST" action="/auth/olvide-password" novalidate)
        input(type="hidden" name="_csrf" value=csrfToken)
        +campo('email', 'Email de Registro', 'email')(placeholder="Tu Email" autocomplete="email")
        div.d-flex.justify-content-between.mt-2
            a.text-muted.text-decoration-none(href="/auth/registro") ¿No tienes cuenta? Crea una
            a.text-muted.text-decoration-none(href="/auth/login") ¿Ya tienes cuenta? Inicia Sesión
        button.btn.btn-primary.mt-3(type="submit") Enviar Instrucciones
