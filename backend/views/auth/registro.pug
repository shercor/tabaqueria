extends ../layouts/auth
include ../mixins/formulario

block titulo
    | Crear cuenta

block formulario
    form(method="POST" action="/auth/registro" novalidate)
        input(type="hidden" name="_csrf" value=csrfToken)
        +campo('nombre', 'Tu Nombre', 'text', usuario.nombre)(placeholder="Tu Nombre" autocomplete="name")
        +campo('email', 'Email de Registro', 'email', usuario.email)(placeholder="Tu Email" autocomplete="email")
        +campo('password', 'Contraseña', 'password')(placeholder="Tu Password" autocomplete="new-password")
        +campo('repeat-password', 'Repetir Contraseña', 'password')(placeholder="Repite Password" autocomplete="new-password")
        div.d-flex.justify-content-between.mt-2
            a.text-muted.text-decoration-none(href="/auth/login") ¿Ya tienes cuenta? Inicia Sesión
            a.text-muted.text-decoration-none(href="/auth/olvide-password") Olvidé mi Password
        button.btn.btn-primary.mt-3(type="submit") Crear Cuenta
