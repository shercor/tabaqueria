extends ../layouts/auth
include ../mixins/formulario

block titulo
    | Restablece tu password

block formulario
    //- Sin action: se envía a la misma URL, que lleva el token
    form(method="POST" novalidate)
        input(type="hidden" name="_csrf" value=csrfToken)
        +campo('password', 'Ingresa tu nuevo Password', 'password')(placeholder="Tu Password" autocomplete="new-password")
        div.d-flex.justify-content-between.mt-2
            a.text-muted.text-decoration-none(href="/auth/registro") ¿No tienes cuenta? Crea una
            a.text-muted.text-decoration-none(href="/auth/login") ¿Ya tienes cuenta? Inicia Sesión
        button.btn.btn-primary.mt-3(type="submit") Guardar Password
