div.floating-icon(id="cartIcon") 🛒

div.modal(id="cartModal")
    div.modal-content
        span.close-btn(id="closeModal") &times;
        h2 Carrito de Compras
        ul#cartItems
        h2(id="totalPriceContain") Total: <span id="totalPrice">$0</span>
        a#checkoutBtn.btn.btn-primary(href="/pedidos/finalizar-pedido") Finalizar compra


script.
    const cartIcon = document.getElementById("cartIcon");
    const cartModal = document.getElementById("cartModal");
    const closeModal = document.getElementById("closeModal");
    const cartItems = document.getElementById("cartItems");
    const checkoutBtn = document.getElementById("checkoutBtn");
    const totalPrice = document.getElementById("totalPrice");
    const totalPriceContain = document.getElementById("totalPriceContain");

    function mostrarCarritoVacio(mensaje) {
        cartItems.innerHTML = `<li>${mensaje}</li>`;
        totalPriceContain.style.display = 'none';
        checkoutBtn.style.display = 'none';
    }

    function htmlDetalle(detalle) {
        const producto = detalle.producto;
        const nombre = escaparHtml(producto.nombre);
        return `
            <div class="d-flex justify-content-between align-items-left" style="width: 100%; height: 120px; padding: 10px; border-bottom: 1px solid #b6bbbf;">
                <div class="d-flex align-items-center" style="gap: 10px;">
                    <img src="${escaparHtml(producto.imagen ?? '/general/no-image.jpg')}" alt="${nombre}" style="width: 100px; height: 100%; object-fit: cover;">
                    <div style="text-align: left;">
                        <strong>${nombre}</strong><br>
                        <div>
                            <strong>Precio Unidad:</strong> ${formatearPesos(detalle.precio)}<br>
                            <strong>Cantidad:</strong> ${detalle.cantidad}<br>
                            <button type="button" class="btn btn-sm btn-secondary mt-2" data-accion="restar" data-detalle-id="${detalle.id}" title="Restar del carrito">-</button>
                            <button type="button" class="btn btn-sm btn-secondary mt-2" data-accion="sumar" data-producto-id="${producto.id}" title="Añadir al carrito">+</button>
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <div><strong>Total:</strong> ${formatearPesos(detalle.precio * detalle.cantidad)}</div>
                    <button type="button" class="btn btn-sm btn-danger mt-2" data-accion="eliminar" data-detalle-id="${detalle.id}" title="Eliminar del carrito">❌</button>
                </div>
            </div>
        `;
    }

    async function actualizarCarrito() {
        const resultado = await enviarJSON("/pedidos/obtener-carrito");

        if (!resultado.success) {
            return mostrarCarritoVacio("Error al cargar el carrito");
        }

        const detalles = resultado.pedido?.detalles_pedido ?? [];
        if (detalles.length === 0) {
            return mostrarCarritoVacio("No has añadido ningún producto todavía");
        }

        cartItems.innerHTML = detalles.map(htmlDetalle).join('');
        totalPrice.innerText = formatearPesos(resultado.pedido.total);
        totalPriceContain.style.display = '';
        checkoutBtn.style.display = '';
    }

    // Un solo listener para los botones +, - y ❌ de todas las líneas
    cartItems.addEventListener("click", async (event) => {
        const boton = event.target.closest("button[data-accion]");
        if (!boton) return;

        const acciones = {
            sumar: () => agregarAlCarro(boton.dataset.productoId),
            restar: () => quitarDelCarro(boton.dataset.detalleId),
            eliminar: () => eliminarDelCarro(boton.dataset.detalleId),
        };

        boton.disabled = true;
        const resultado = await acciones[boton.dataset.accion]();
        if (!resultado.success) mostrarError(resultado.message);
        await actualizarCarrito();
    });

    cartIcon.addEventListener("click", () => {
        cartModal.style.display = "flex";
        actualizarCarrito();
    });

    closeModal.addEventListener("click", () => {
        cartModal.style.display = "none";
    });

    // Cerrar modal si se hace clic fuera
    window.addEventListener("click", (event) => {
        if (event.target === cartModal) {
            cartModal.style.display = "none";
        }
    });
