//- La lógica está en public/js/carrito-modal.js
button.carrito-flotante#carrito-abrir(type="button" title="Ver carrito" aria-label="Ver carrito") 🛒

div.carrito-modal#carrito-modal(role="dialog" aria-modal="true" aria-labelledby="carrito-titulo")
    div.carrito-modal__contenido
        button.carrito-modal__cerrar#carrito-cerrar(type="button" aria-label="Cerrar") &times;
        h2#carrito-titulo Carrito de Compras
        div#carrito-lineas
        h2#carrito-total-contenedor Total: <span id="carrito-total">$0</span>
        a.btn.btn-primary#carrito-checkout(href="/pedidos/finalizar-pedido") Finalizar compra
