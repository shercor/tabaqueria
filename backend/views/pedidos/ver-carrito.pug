extends ../layout/index

block contenido
    //- Resumen del carrito antes de finalizar la compra
    div.container.py-5(style="max-width:1000px;")
        h1.text-center.mb-5= pagina

        if detalles.length
            div.bg-white.py-3.px-4.shadow
                each detalle in detalles
                    div.d-flex.justify-content-between.align-items-center.py-2.border-bottom
                        div.d-flex.align-items-center(style="gap: 10px;")
                            img(src=detalle.producto.imagen || '/general/no-image.jpg', alt=detalle.producto.nombre, style="width: 100px; height: 100px; object-fit: cover;")
                            div
                                strong= detalle.producto.nombre
                                div Precio unidad: #{formatearPesos(detalle.precio)}
                                div Cantidad: #{detalle.cantidad}
                        div.text-end
                            div
                                strong Total:
                                |  #{formatearPesos(detalle.precio * detalle.cantidad)}
                            button.btn.btn-sm.btn-danger.mt-2(type="button" data-eliminar=detalle.id title="Eliminar del carrito") ❌

                div.d-flex.justify-content-end.pt-3
                    h4 Total: #{formatearPesos(pedido.total)}

            form#form-finalizar.bg-white.py-3.px-4.shadow.mt-4(data-pedido-id=pedido.id)
                h5.mb-3 ¿Cómo quieres recibir tu pedido?
                div.form-check
                    input.form-check-input(type="radio" name="delivery" id="retiro" value="false" checked)
                    label.form-check-label(for="retiro") Retiro en tienda
                div.form-check
                    input.form-check-input(type="radio" name="delivery" id="delivery" value="true")
                    label.form-check-label(for="delivery") Despacho a domicilio
                div.text-center.mt-3
                    button.btn.btn-primary(type="submit") Finalizar compra
        else
            div.bg-white.py-4.px-4.shadow.text-center
                p.mb-3 No tienes productos en el carrito.
                a.btn.btn-primary(href="/productos/lista") Ver productos

    script.
        document.querySelectorAll("[data-eliminar]").forEach(boton => {
            boton.addEventListener("click", async () => {
                const resultado = await eliminarDelCarro(boton.dataset.eliminar);
                if (!resultado.success) return mostrarError(resultado.message);
                location.reload();
            });
        });

        const formFinalizar = document.getElementById("form-finalizar");
        formFinalizar?.addEventListener("submit", async (event) => {
            event.preventDefault();
            const boton = formFinalizar.querySelector("button[type=submit]");
            boton.disabled = true;

            const delivery = formFinalizar.elements.delivery.value === "true";
            const resultado = await enviarJSON(`/pedidos/finalizar/${formFinalizar.dataset.pedidoId}`, "PATCH", { delivery });

            if (!resultado.success) {
                boton.disabled = false;
                return mostrarError(resultado.message);
            }

            await Swal.fire({ icon: "success", title: "¡Pedido realizado!", text: "Tu pedido quedó registrado." });
            location.href = "/productos/lista";
        });
