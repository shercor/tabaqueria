extends ../layout/index

block contenido
    div.py-5 
        h1(class="d-flex justify-content-center") Editar producto
        include ../components/errores
        .mt-5.mx-auto(style="max-width:600px;")
            div.bg-white.py-3.px-4.shadow
                //- En formularios con archivos el token CSRF va en la URL: el body se lee recién después del chequeo CSRF
                form(action=`/productos/editar/${producto.id}?_csrf=${csrfToken}` method="POST" enctype="multipart/form-data")
                    input(type="hidden" name="estado" value= "1")
                    
                    div.mt-2
                        label(class="form-label text-uppercase text-muted mb-2 fw-bold" for="nombre") Nombre del Producto
                        input(type="text" id="nombre" name="nombre" class="form-control" required value=producto.nombre)
                    
                    div.mt-2
                        label(class="form-label text-uppercase text-muted mb-2 fw-bold" for="descripcion") Descripción
                        textarea(id="descripcion" name="descripcion" class="form-control" rows="3")= producto.descripcion
                    
                    div.row
                        div.mt-2.col-4
                            label(class="form-label text-uppercase text-muted mb-2 fw-bold" for="precio") Precio
                            div.input-group
                                span.input-group-text
                                    i.fas.fa-dollar-sign
                                input(type="number" id="precio" name="precio" min="100" class="form-control" required value=producto.precio)
                        
                        div.mt-2.col-2
                            label(class="form-label text-uppercase text-muted mb-2 fw-bold" for="stock") Stock
                            input(type="number" id="stock" name="stock" min="0" class="form-control" required value=producto.stock)
                    
                        div.mt-2.col-6
                            label(class="form-label text-uppercase text-muted mb-2 fw-bold" for="categoria") Categoría
                            select(id="categoria" name="categoria_id" class="form-control")
                                option(value="") Selecciona una categoría
                                each categoria in categorias
                                    option(value=categoria.id selected= categoria.id == producto.categoria_id) #{categoria.nombre}
                    
                    div.mt-2
                        label(class="form-label text-uppercase text-muted mb-2 fw-bold" for="imagen") Imagen
                        input(type="file" id="imagen" name="imagen" accept="image/jpeg,image/png,image/webp,image/gif" class="form-control")
                    p.mt-2.text-muted.text-center
                        if producto.imagen
                            | Imagen actual (se mantiene si no subes otra)
                        else
                            | No hay imagen disponible
                    div.mt-2.text-center
                        img(src=producto.imagen || '/general/no-image.jpg', id="imgproducto" alt="Imagen del producto", class="img-fluid", style="max-width: 200px; max-height: 200px;")
                    input(type="submit" value="Guardar Producto" class="btn btn-primary mt-3")

    script.
        // Previsualiza la imagen elegida antes de guardar
        const inputImagen = document.getElementById("imagen");
        const imgProducto = document.getElementById("imgproducto");

        inputImagen.addEventListener("change", function () {
            const archivo = this.files[0];
            if (!archivo) return;

            const lector = new FileReader();
            lector.onload = evento => { imgProducto.src = evento.target.result; };
            lector.readAsDataURL(archivo);
        });
