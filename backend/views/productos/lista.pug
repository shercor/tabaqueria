extends ../layouts/base

block contenido
    div.d-flex.py-5.w-100
        include ../partials/filtros-productos

        div.container
            h1.text-center= pagina
            div.catalogo.mt-5.mx-auto
                if productos.length
                    div.catalogo__grilla
                        each producto in productos
                            div.producto-tarjeta
                                img.producto-tarjeta__imagen(src=producto.imagen || '/general/no-image.jpg' alt=producto.nombre)
                                p.producto-tarjeta__nombre= producto.nombre
                                p.pb-3.mb-1= formatearPesos(producto.precio)
                                if producto.stock > 0
                                    button.boton-carrito(type="button" data-producto-id=producto.id)
                                        i.fa-solid.fa-cart-plus.me-2
                                        | Añadir al carro
                                else
                                    button.boton-carrito(type="button" disabled) Sin stock
                else
                    p.text-center.my-4 No hay productos que coincidan con la búsqueda.

        div.espaciador-lateral

block scripts
    script(type="module" src="/js/productos.js")
