extends ../layout/index

block contenido
    div.py-5.d-flex(id="contenedor-productos" style="width:100%;")
        include ../components/filtro-productos      
        div.container()
            h1(class="d-flex justify-content-center")= pagina
            .mt-5.mx-auto(style="max-width:1400px;")
                div.bg-white.py-3.px-4.shadow.row
                    if productos.length
                        each producto in productos
                            div.mb-5.col-3
                                div.pb-3.product-item(style="display: flex; flex-direction: column; align-items: center; border:solid #c1b8b8 1px; border-radius:10px; overflow:hidden;")
                                    img(src=producto.imagen || '/general/no-image.jpg' alt=producto.nombre class="mx-2" style="width:100%; height: 300px; object-fit: cover; border-bottom: solid #b6bbbf 1px;")
                                    div.d-flex.align-items-center(style="font-weight:bold; height:68px")
                                        p(class="p-2 mb-1" style="text-align: center;")= producto.nombre
                                    p(class="pb-3 mb-1")= formatearPesos(producto.precio)
                                    if producto.stock > 0
                                        button.add-to-cart(data-id= producto.id type="button")
                                            i(class="fa-solid fa-cart-plus me-2")
                                            span Añadir al carro
                                    else
                                        button.add-to-cart(type="button" disabled) Sin stock
                    else
                        p.text-center.my-4 No hay productos que coincidan con la búsqueda.
        div(style="width:25%;")

    script.
        document.querySelectorAll(".add-to-cart[data-id]").forEach(boton => {
            boton.addEventListener("click", async function () {
                const resultado = await agregarAlCarro(this.dataset.id);

                if (!resultado.success) {
                    return mostrarError(resultado.message || 'Hubo un problema al agregar el producto');
                }

                Swal.fire({
                    title: '¡Producto añadido al carro!',
                    icon: 'success',
                    timer: 2000,
                    confirmButtonText: 'Ok',
                });
            });
        });
